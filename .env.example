# ── Database (required) ───────────────────────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/ceramicbot

# ── PII encryption (required) ─────────────────────────────────────────
# 32-byte hex key. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Tenant mode ───────────────────────────────────────────────────────
# "single" (one client, no auth context needed) | "multi" (SaaS)
TENANT_MODE=single

# ── OpenAI ────────────────────────────────────────────────────────────
# Used by /api/chat/ask to answer side questions a user types alongside
# the chat flow's chips. Off-flow answers degrade gracefully if unset.
OPENAI_API_KEY=
# Override the model if needed (default: gpt-4o-mini)
CHAT_AI_MODEL=gpt-4o-mini

# ── Email lead alerts (Resend) ────────────────────────────────────────
# When a lead is captured, the factory's configured recipients (Settings →
# "Lead alert emails", up to 3) get an email. Unset RESEND_API_KEY → emails
# are skipped (logged once); leads still persist and show in the dashboard.
# Get a key at https://resend.com. The From address must be on a domain you've
# verified in Resend; the per-factory business name is used as the display name.
RESEND_API_KEY=
# From address. Format: "Display <addr@verified-domain>" or a bare address.
# Defaults to Resend's sandbox sender (onboarding@resend.dev) if unset.
RESEND_FROM=CeramicBot <leads@aurexauto.com>

# ── WhatsApp Business Cloud API (later slice) ─────────────────────────
# Per-client creds are stored encrypted in ceramic_clients; these are
# only platform-level fallbacks/verification if needed.
# WHATSAPP_VERIFY_TOKEN=

# ── Admin auth / session (Phase 2 admin API) ─────────────────────────
# Signing secret for express-session cookies. Generate with: openssl rand -base64 64
SESSION_SECRET=
# Demo FACTORY admin login. On boot this is seeded as a factory-scoped admin
# bound to the demo client (so the existing demo dashboard login keeps working).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Super-admin (Aurex Auto operator — cross-tenant) ─────────────────
# Seeded on first boot if no superadmin exists. If SUPERADMIN_PASSWORD is unset,
# a random password is generated and printed ONCE to the server log — copy it.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=

# ── Runtime ───────────────────────────────────────────────────────────
PORT=5000

# ── Keep-alive (production only) ──────────────────────────────────────
# In production the server self-pings GET /health every 10 min so Render's
# free tier doesn't spin down on idle. The ping URL is auto-detected from
# RENDER_EXTERNAL_URL (Render injects it). Set KEEP_ALIVE_URL only to override
# (e.g. a custom domain). Loopback is used as a last-resort fallback.
# KEEP_ALIVE_URL=https://your-app.onrender.com

# ── Gmail inbox ingest (Slice 1) ──────────────────────────────────────
# Connect an exporter's Gmail to read buyer inquiries + (later) send replies.
# Reuses the clinic-connect Google OAuth pattern. Create an OAuth 2.0 Client
# (Web application) in Google Cloud, enable the Gmail API, and add the three
# Gmail scopes (readonly, send, modify) to the consent screen. See
# docs/gmail-setup.md for the one-time setup walkthrough.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base URL used to build the OAuth redirect (…/api/admin/email/callback).
# Defaults to http://localhost:5000 if unset.
APP_BASE_URL=http://localhost:5000
