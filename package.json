{
  "name": "ceramicbot",
  "version": "1.0.0",
  "description": "CeramicBot — AI WhatsApp & Web Chat Bot for ceramic factories & exporters (Aurex Auto).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --names \"api,web\" --prefix-colors \"cyan,magenta\" --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "CHOKIDAR_USEPOLLING=true tsx watch --env-file-if-exists=.env --env-file-if-exists=.env.local --tsconfig server/tsconfig.json server/index.ts",
    "build": "tsx script/build.ts",
    "build:client": "npm run build --workspace client",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "npm run preview --workspace client",
    "check": "npm run check --workspace client",
    "check:server": "npm run check --workspace server",
    "test:server": "npm run test --workspace server",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.7.1"
  }
}
